# Приклади змінних середовища. Скопіюйте у .env.local і змініть за потреби.
# У репозиторій не додаються реальні токени, паролі чи дані організації.

# demo — локальні демонстраційні дані без входу (типово для розробки)
# portal — реальний вхід через ArcGIS Enterprise Portal і читання шарів
VITE_AUTH_MODE=portal

# Адреса Portal
VITE_PORTAL_URL=https://gis.htgoims.org/portal

# Публічний Client ID OAuth-застосунку (не секрет)
VITE_OAUTH_CLIENT_ID=UkLjSBHNNooE1jnb

# Адреса повернення після входу. Має точно збігатися з Redirect URI,
# доданим у налаштуваннях OAuth-застосунку Portal (включно зі слешем).
# Локально (Vite base = /CASEVAC_editor/): http://localhost:5173/CASEVAC_editor/
# GitHub Pages: https://<org>.github.io/<repo>/
VITE_OAUTH_REDIRECT_URI=https://haloukrainegis.github.io/CASEVAC_editor/

# Ідентифікатор веб-карти
VITE_WEBMAP_ID=f5c528f766ec467c9d7388787bc58698

# Маршрутизація для напівавтоматичної побудови.
# arcgis — Network Analysis на Portal (основний варіант, потребує входу);
# osrm   — публічний OSRM (лише для демо/розробки, координати йдуть третій стороні).
VITE_ROUTING_PROVIDER=arcgis

# Адреса сервісу Route_World у Portal
VITE_ROUTING_ARCGIS_URL=https://gis.htgoims.org/portal/sharing/servers/ecad41490e704f8680c3468c0b2f7c6b/rest/services/World/Route/NAServer/Route_World

# Адреса OSRM (використовується лише при VITE_ROUTING_PROVIDER=osrm)
VITE_ROUTING_OSRM_URL=https://router.project-osrm.org

# Таймаут запиту до сервісу маршрутизації, мс
VITE_ROUTING_TIMEOUT_MS=12000

# Допуск спрощення геометрії, метри
VITE_ROUTING_SIMPLIFY_METERS=20
