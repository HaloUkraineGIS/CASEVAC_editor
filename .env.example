# Приклади змінних середовища. Скопіюйте у .env.local і змініть за потреби.
# У репозиторій не додаються реальні токени, паролі чи дані організації.

# demo — локальні демонстраційні дані без входу (типово для розробки)
# portal — реальний вхід через ArcGIS Enterprise Portal і читання шарів
VITE_AUTH_MODE=portal

# Адреса Portal
VITE_PORTAL_URL=https://gis.htgoims.org/portal

# Публічний Client ID OAuth-застосунку (не секрет)
VITE_OAUTH_CLIENT_ID=UkLjSBHNNooE1jnb

# Адреса повернення після входу. Має бути додана в налаштуваннях застосунку Portal.
# Локально: http://localhost:5173/
# GitHub Pages: https://<org>.github.io/<repo>/
VITE_OAUTH_REDIRECT_URI=https://haloukrainegis.github.io/CASEVAC_editor/

# Ідентифікатор веб-карти
VITE_WEBMAP_ID=f5c528f766ec467c9d7388787bc58698
